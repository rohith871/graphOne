# Environment & API Keys (CRITICAL: Never commit keys)
.env
.env.*
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class

# Data Directory (Ignore raw and scraped output files, keep folder structure)
data/raw/*
data/output/*
!data/raw/.gitkeep
!data/output/.gitkeep

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
